      <aliases enabled='yes' />
      <column caption='延迟天数' datatype='integer' name='[Calculation_2088584708431873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_estimated_delivery_date], [order_delivered_customer_date])' />
      </column>
      <column caption='延迟分桶' datatype='string' name='[Calculation_2088584708505602]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [delivery_status] = &quot;on_time&quot; THEN &quot;1. 准时/提前&quot;&#13;&#10;ELSEIF [Calculation_2088584708431873] &lt;= 3 THEN &quot;2. 晚 1–3 天&quot;&#13;&#10;ELSEIF [Calculation_2088584708431873] &lt;= 7 THEN &quot;3. 晚 4–7 天&quot;&#13;&#10;ELSE &quot;4. 晚 7 天以上&quot;&#13;&#10;END' />
      </column>
      <column caption='差评率' datatype='real' name='[Calculation_2088584708595715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [review_score] &lt;= 2 THEN 1 ELSE 0 END) / COUNTD([order_id])' />
      </column>
      <column caption='州迟到率' datatype='real' name='[Calculation_2088584708685828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [delivery_status] = &quot;late&quot; THEN 1 ELSE 0 END) / COUNTD([order_id])' />
      </column>
      <column caption='迟到率' datatype='real' name='[Calculation_2088584711028741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [delivery_status] = &quot;late&quot; THEN 1 ELSE 0 END) / COUNTD([order_id])' />
      </column>
      <column caption='COUNTD([Order Id])' datatype='integer' name='[Calculation_2088584729210888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='平均评分' datatype='real' name='[Calculation_2088584736972813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([review_score])' />
      </column>
      <column caption='订单数' datatype='integer' name='[Calculation_2088584737239055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2088584729210888]' />
      </column>

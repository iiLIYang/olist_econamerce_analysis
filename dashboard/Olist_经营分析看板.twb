    <worksheet name='延迟分桶与评分'>
      <layout-options>
        <title>
          <formatted-text>
            <run>延迟越久，评分越低</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='v_order_base (olist)' name='federated.08dr98901aslgv15muxt80vh2gnf' />
          </datasources>
          <datasource-dependencies datasource='federated.08dr98901aslgv15muxt80vh2gnf'>
            <column caption='延迟天数' datatype='integer' name='[Calculation_2088584708431873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_estimated_delivery_date], [order_delivered_customer_date])' />
            </column>
            <column caption='延迟分桶' datatype='string' name='[Calculation_2088584708505602]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [delivery_status] = &quot;on_time&quot; THEN &quot;1. 准时/提前&quot;&#13;&#10;ELSEIF [Calculation_2088584708431873] &lt;= 3 THEN &quot;2. 晚 1–3 天&quot;&#13;&#10;ELSEIF [Calculation_2088584708431873] &lt;= 7 THEN &quot;3. 晚 4–7 天&quot;&#13;&#10;ELSE &quot;4. 晚 7 天以上&quot;&#13;&#10;END' />
            </column>
            <column caption='差评率' datatype='real' name='[Calculation_2088584708595715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [review_score] &lt;= 2 THEN 1 ELSE 0 END) / COUNTD([order_id])' />
            </column>
            <column-instance column='[review_score]' derivation='Avg' name='[avg:review_score:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_id]' derivation='CountD' name='[ctd:order_id:qk]' pivot='key' type='quantitative' />
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' type='nominal' />
            <column caption='Delivery Days' datatype='integer' name='[delivery_days]' role='measure' type='quantitative' />
            <column caption='Delivery Status' datatype='string' name='[delivery_status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2088584708505602]' derivation='None' name='[none:Calculation_2088584708505602:nk]' pivot='key' type='nominal' />
            <column caption='Order Delivered Customer Date' datatype='datetime' name='[order_delivered_customer_date]' role='dimension' type='ordinal' />
            <column caption='Order Estimated Delivery Date' datatype='datetime' name='[order_estimated_delivery_date]' role='dimension' type='ordinal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Review Score' datatype='integer' name='[review_score]' role='measure' type='quantitative' />
            <column-instance column='[delivery_days]' derivation='Sum' name='[sum:delivery_days:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2088584708595715]' derivation='User' name='[usr:Calculation_2088584708595715:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.08dr98901aslgv15muxt80vh2gnf].[Action (Customer State)]'>
            <groupfilter function='level-members' level='[customer_state]' user:ui-action-filter='[Action3_1D6CFD2C859C4B73A93C5DE103E7D494]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.08dr98901aslgv15muxt80vh2gnf].[Action (Customer State)]</column>

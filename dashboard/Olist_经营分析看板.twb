              <calculation class='tableau' formula='STR(COUNTD([customer_unique_id])) + &quot; (&quot; + STR(ROUND(COUNTD([customer_unique_id]) / TOTAL(COUNTD([customer_unique_id])) * 100, 2)) + &quot;%)&quot;'>

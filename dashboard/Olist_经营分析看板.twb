        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.08dr98901aslgv15muxt80vh2gnf].[avg:review_score:qk]' field-type='quantitative' fold='true' max='5.0' min='1.0' range-type='fixed' scope='rows' type='space' />

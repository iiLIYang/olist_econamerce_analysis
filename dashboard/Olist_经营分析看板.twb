      <aliases enabled='yes' />
      <column caption='AOV' datatype='real' name='[Calculation_1392318555070465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payment_total])/COUNTD([order_id])' />
      </column>
      <column caption='履约率' datatype='real' name='[Calculation_1392318555750402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [order_status] = &apos;delivered&apos; THEN 1 ELSE 0 END)/COUNTD([order_id])' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_1392318566436869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_valid_order] = 1 THEN [payment_total] END)' />
      </column>
      <column caption='order_count' datatype='integer' name='[Calculation_1392318566690822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_valid_order] = 1 THEN [order_id] END)' />
      </column>
      <column caption='客单价' datatype='real' name='[Calculation_1392318567227399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1392318566436869]/[Calculation_1392318567825416]' />
      </column>
      <column caption='有效订单量' datatype='integer' name='[Calculation_1392318567825416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_valid_order] = 1 THEN [order_id] END)' />
      </column>
      <column caption='月份' datatype='string' name='[Calculation_1392318588117002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([order_purchase_timestamp])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(MONTH([order_purchase_timestamp])), 2)' />
      </column>
